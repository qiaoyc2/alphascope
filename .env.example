# Required for SEC EDGAR requests. Replace the placeholder with a real contact email.
# The LLM demo automatically loads the repository .env without replacing shell values.
ALPHASCOPE_SEC_USER_AGENT="AlphaScope/0.1 contact=<your-email-address>"

LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0
LLM_NUM_CTX=4096
OLLAMA_BASE_URL=http://localhost:11434
LLM_THINKING=false
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_NUM_PREDICT=512

# Hosted OpenAI inference is reserved for a future provider implementation.
# LLM_PROVIDER=openai
# LLM_MODEL=<supported-openai-model-id>
# OPENAI_API_KEY=
# OPENAI_PAID_ENABLED=false
